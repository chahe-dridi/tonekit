{
  "name": "tonekit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tonekit/site",
    "build": "npm run build -w tonekit-themes && npm run build -w @tonekit/site",
    "build:lib": "npm run build -w tonekit-themes",
    "build:site": "npm run build -w @tonekit/site",
    "preview": "npm run preview -w @tonekit/site",
    "test": "npm test -w tonekit-themes",
    "release": "node scripts/release.mjs",
    "media": "node scripts/readme-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0"
  }
}
